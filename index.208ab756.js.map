"use strict";
var mainImg = document.getElementById("largeImg");
var images = document.getElementById("thumbs");
images.addEventListener("click", function(ev) {
    ev.preventDefault();
    var link = ev.target.closest("a");
    if (!link) return;
    var image = link.querySelector("img");
    var srcValue = image.getAttribute("src");
    mainImg.setAttribute("src", srcValue);
});

